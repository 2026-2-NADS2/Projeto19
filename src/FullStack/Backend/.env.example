DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kfka
# Ligue somente no backend de teste, após aplicar a migração SQL.
KFKA_CIENCIA_LEGAL_TESTE=false

# Gere uma chave aleatória e mantenha-a fora do Git.
JWT_SECRET=
JWT_EXPIRES_IN=2h
# Demonstração local. Requer NODE_ENV=development, HOST=127.0.0.1 e MySQL local.
KFKA_RECUPERACAO_LOCAL=false
